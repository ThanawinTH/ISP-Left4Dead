# Copy this file to .env (same folder) and fill in the two Google values.
# .env is in .gitignore - never push it. Share it with the team privately.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 1 turns on POST /api/auth/test-login for the automated tests. Leave 0 for the demo.
TEST_LOGIN=0
